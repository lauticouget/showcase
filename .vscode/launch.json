{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to SAM local-api",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "localRoot": "${workspaceFolder}/dist/apps/api",
      "remoteRoot": "/var/task",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ]
}
