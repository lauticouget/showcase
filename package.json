{
  "name": "@showcase/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "pnpm nx lint api && pnpm nx lint web",
    "watch:typecheck": "nx typecheck api --watch",
    "build:api": "nx build api",
    "watch:api": "nx build api --watch --skip-nx-cache",
    "kill:container": "docker ps -q --filter publish=9229 | xargs -r docker stop || true",
    "dynamo:start": "docker compose -f ./infra/docker-compose.local.yaml up -d --wait && node ./scripts/create-local-table.mjs",
    "dynamo:stop": "docker compose -f ./infra/docker-compose.local.yaml down",
    "sam": "sam local start-api -t ./infra/template.yaml --warm-containers LAZY --docker-network showcase-local --env-vars ./infra/env.local.json",
    "sam:inspect": "pnpm kill:container && sam local start-api -t ./infra/template.yaml --warm-containers LAZY --debug-port 9229 --docker-network showcase-local --env-vars ./infra/env.local.json",
    "sam:inspect:pretty": "pnpm kill:container && sam local start-api -t ./infra/template.yaml --warm-containers LAZY --debug-port 9229 --docker-network showcase-local --env-vars ./infra/env.local.json 2>&1 | node ./scripts/pretty-logs.mjs",
    "dev:api": "pnpm dynamo:start && concurrently --kill-others --names \"BUILD,SAM,TYPES\" -c \"cyan,magenta,yellow\" \"pnpm watch:api\" \"pnpm sam:inspect:pretty\" \"pnpm watch:typecheck\""
  },
  "nx": {},
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@graphql-codegen/cli": "^6.1.2",
    "@graphql-codegen/typescript": "^5.0.8",
    "@graphql-codegen/typescript-operations": "^5.0.8",
    "@next/eslint-plugin-next": "^16.0.1",
    "@nx/devkit": "22.2.0",
    "@nx/esbuild": "22.3.1",
    "@nx/eslint": "22.2.0",
    "@nx/eslint-plugin": "22.2.0",
    "@nx/jest": "22.2.0",
    "@nx/js": "22.3.1",
    "@nx/next": "^22.2.0",
    "@nx/node": "22.3.1",
    "@nx/playwright": "22.2.0",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.15.3",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/aws-lambda": "^8.10.160",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.13",
    "babel-jest": "^30.0.2",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "esbuild": "^0.19.2",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "22.2.0",
    "postcss": "8.4.38",
    "prettier": "^2.6.2",
    "tailwindcss": "3.4.3",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/aws-lambda": "^4.0.1",
    "@aws-lambda-powertools/logger": "^2.31.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1004.0",
    "@aws-sdk/client-dynamodb": "^3.999.0",
    "@aws-sdk/lib-dynamodb": "^3.999.0",
    "@graphql-tools/merge": "^9.1.7",
    "@graphql-tools/schema": "^10.0.31",
    "@graphql-tools/utils": "^11.0.0",
    "aws-jwt-verify": "^5.1.1",
    "aws-lambda": "^1.0.7",
    "axios": "^1.6.0",
    "graphql": "^16.12.0",
    "graphql-tag": "^2.12.6",
    "next": "~16.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}